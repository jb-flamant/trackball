/*
 * Overlay carte : RP2040-Zero + PMW3610 (souris HID USB)
 * ------------------------------------------------------
 * Reprend le pinctrl `spi0_default` fourni par la carte (rp2040_zero-pinctrl.dtsi) :
 *     SCK          = GP6   (SPI0_SCK_P6)
 *     MOSI (TX)    = GP3   (SPI0_TX_P3)
 *     MISO (RX)    = GP4   (SPI0_RX_P4)
 *
 * Le PMW3610 est un capteur SPI 3 fils HALF-DUPLEX : il n'a qu'une seule broche de
 * donnees bidirectionnelle (SDIO). Sur le RP2040 (SPI full-duplex), on relie donc
 * GP3 (MOSI) et GP4 (MISO) ENSEMBLE, cote carte, vers la broche SDIO du capteur.
 * En lecture, le driver met la ligne en haute impedance cote MCU.
 *
 * Lignes de controle (GPIO) choisies sur des broches libres du RP2040-Zero :
 *     NCS    = GP5   (chip select, actif bas)
 *     MOTION = GP7   (interruption capteur, actif bas, pull-up)
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&spi0 {
	status = "okay";
	cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;

	/* Driver PMW3610 fourni en amont par Zephyr (drivers/input). */
	pmw3610: pmw3610@0 {
		compatible = "pixart,pmw3610";
		reg = <0>;
		spi-max-frequency = <2000000>;   /* PMW3610 : SCLK <= 2 MHz */
		motion-gpios = <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		res-cpi = <800>;                 /* resolution ; a ajuster */
		zephyr,axis-x = <INPUT_REL_X>;
		zephyr,axis-y = <INPUT_REL_Y>;

		/* Orientation (a regler une fois la carte montee) :
		 * invert-x;
		 * invert-y;
		 */
	};
};

/*
 * Boutons de la souris (gpio-keys). Actifs bas avec pull-up interne : une entree
 * non connectee est lue au niveau inactif (bouton relache) -> aucun clic fantome
 * si le poussoir n'est pas cable. Broches libres du RP2040-Zero.
 */
/ {
	buttons {
		compatible = "gpio-keys";

		btn_left: button_left {
			gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_BTN_LEFT>;
		};
		btn_right: button_right {
			gpios = <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_BTN_RIGHT>;
		};
		btn_middle: button_middle {
			gpios = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_BTN_MIDDLE>;
		};
		/* Bouton de bascule du mode molette (non transmis a l'hote). */
		btn_scroll: button_scroll {
			gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_SCROLLLOCK>;
		};
	};
};

/* Souris HID (nouveau stack USB device_next) */
/ {
	hid_dev_0: hid_dev_0 {
		compatible = "zephyr,hid-device";
		label = "HID0";
		protocol-code = "mouse";         /* souris boot-capable (BIOS/UEFI) */
		in-polling-period-us = <1000>;   /* 1 kHz */
		in-report-size = <8>;
	};
};

/* Console de debug sur USB CDC-ACM (pas d'UART cablee en facade) */
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
	};
};
